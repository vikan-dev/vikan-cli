{
  "name": "@vikan/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "vikan CLI \u2014 run Codex inside Herdr and follow vikan runs from the terminal",
  "bin": {
    "vikan": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "vendor",
    "README.md",
    "DELIVERABLES.md",
    "TESTING.md",
    "PUBLISHING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev:cli": "bun run src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun scripts/test.ts",
    "smoke": "bun scripts/smoke.ts",
    "check": "bun run typecheck && bun run test && bun run build && bun run smoke",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@s2-dev/streamstore": "0.27.0",
    "@t3-oss/env-core": "^0.13.11",
    "marked": "18.0.14",
    "zod": "4.4.3",
    "@vikan/sdk": "github:vikan-dev/vikan-sdk#5a5512da7bbb2e3c1ef383bb57ee6910bb15f5c9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikan-dev/vikan-cli.git"
  },
  "homepage": "https://github.com/vikan-dev/vikan-cli#readme",
  "bugs": {
    "url": "https://github.com/vikan-dev/vikan-cli/issues"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./entrypoint": "./src/index.ts",
    "./internal/*": "./src/*.ts",
    "./package.json": "./package.json"
  }
}
